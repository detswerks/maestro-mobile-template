# Target Application Package / Bundle Identifiers
APP_ID="com.example.app"
ANDROID_APP_ID="com.example.app"
IOS_APP_ID="com.example.app.ios"

# Environment Endpoints & Configuration
BASE_URL="https://staging.example.com"
API_TIMEOUT="10000"

# Maestro Runner Driver & Telemetry Controls
# Enforces 100% open-source drivers by default:
# Android: uiautomator2 | iOS: wda (override with devicelab if desired)
MAESTRO_RUNNER_NO_TELEMETRY=1
MAESTRO_ENV_FILE=".env"
