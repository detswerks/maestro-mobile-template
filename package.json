{
  "name": "maestro-mobile-template",
  "version": "1.0.0",
  "description": "Agentic mobile UI test automation starter template powered by official Maestro CLI",
  "private": true,
  "scripts": {
    "test": "maestro test",
    "test:staging": "./scripts/run.sh --env staging",
    "test:prod": "./scripts/run.sh --env production",
    "test:smoke": "./scripts/run.sh --env staging -t smoke -x demo",
    "test:regression": "./scripts/run.sh --env staging -t regression -x demo",
    "test:parallel": "./scripts/run.sh --parallel 2 -x demo",
    "test:android": "./scripts/run.sh --platform android -x demo",
    "test:ios": "./scripts/run.sh --platform ios -x demo",
    "test:emulator": "./scripts/run.sh --emulator -x demo",
    "lint": "node scripts/lint.js steps/ tests/",
    "scan:screen": "maestro hierarchy --compact",
    "pom:scan": "node scripts/harvest-pom.js",
    "doctor": "maestro --version && maestro list-devices"
  },
  "keywords": [
    "maestro",
    "mobile-automation",
    "e2e-testing",
    "android",
    "ios",
    "page-object-model"
  ],
  "license": "Apache-2.0"
}
